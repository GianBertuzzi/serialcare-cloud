# Administrado por Ansible. No editar manualmente.
POSTGRES_DB={{ database_name | to_json }}
POSTGRES_USER={{ database_user | to_json }}
POSTGRES_PASSWORD={{ database_password | to_json }}
{% if database_host | default('') | length > 0 %}
DATABASE_URL="postgresql://{{ database_user }}:{{ database_password | urlencode }}@{{ database_host }}:{{ database_port | default(5432) }}/{{ database_name }}?sslmode={{ database_sslmode | default('no-verify') }}"
{% endif %}
BOOTSTRAP_ADMIN_NAME={{ bootstrap_admin_name | to_json }}
BOOTSTRAP_ADMIN_EMAIL={{ bootstrap_admin_email | lower | to_json }}
BOOTSTRAP_ADMIN_PASSWORD={{ bootstrap_admin_password | to_json }}
BOOTSTRAP_ADMIN_PASSWORD_HASH=
JWT_SECRET={{ jwt_secret | to_json }}
FRONTEND_URL={{ serialcare_frontend_url | to_json }}
AZURE_STORAGE_CONNECTION_STRING={{ azure_storage_connection_string | default('') | to_json }}
AZURE_BLOB_CONTAINER={{ azure_blob_container | default('serialcare') | to_json }}
AZURE_STORAGE_CONTAINER={{ azure_blob_container | default('serialcare') | to_json }}
